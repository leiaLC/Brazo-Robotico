<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="abb_irb14050">

    <!--
        Top-level xacro. Declares the public arguments and wires the
        ros2_control macro with the chosen simulation mode.

        sim_mode values:
          - mock   → mock_components/GenericSystem (default; RViz-only)
          - gazebo → gz_ros2_control/GazeboSimSystem + <gazebo><plugin> block
          - real   → placeholder for EGM hardware_interface (currently mock)
    -->

    <xacro:arg name="initial_positions_file" default="initial_positions.yaml"/>
    <xacro:arg name="sim_mode" default="mock"/>

    <!-- Import the kinematic description (links, joints, meshes) -->
    <xacro:include filename="$(find abb_irb14050_description)/urdf/abb_irb14050.urdf"/>

    <!-- Import the ros2_control macro definition -->
    <xacro:include filename="abb_irb14050.ros2_control.xacro"/>

    <!-- Instantiate ros2_control with the runtime-selected backend -->
    <xacro:abb_irb14050_ros2_control
        name="IRB14050System"
        initial_positions_file="$(arg initial_positions_file)"
        sim_mode="$(arg sim_mode)"/>

</robot>
